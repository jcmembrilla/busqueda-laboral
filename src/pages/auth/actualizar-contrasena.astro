---
import Layout from '../../layouts/Layout.astro'
import LogoBrand from '../../components/LogoBrand.astro'
---

<Layout title="Búsqueda Laboral - Nueva contraseña">
  <main class="max-w-md mx-auto px-6 pt-16 pb-12 flex flex-col min-h-dvh items-center justify-center">
    <div id="estado-cargando" class="text-center">
      <div class="mb-6">
        <LogoBrand />
      </div>
      <div
        class="w-14 h-14 mx-auto mb-6 rounded-full flex items-center justify-center"
        style="background: rgba(16,185,129,0.12); border: 2px solid rgba(16,185,129,0.3)"
      >
        <div class="w-7 h-7 border-2 border-emerald-500 border-t-transparent rounded-full animate-spin"></div>
      </div>
      <p class="text-sm font-semibold" style="color: var(--primary)">
        Verificando tu link...
      </p>
    </div>

    <div id="estado-error" class="text-center hidden">
      <div class="mb-6">
        <LogoBrand />
      </div>
      <div
        class="w-16 h-16 mx-auto mb-6 rounded-full flex items-center justify-center"
        style="background: rgba(220,38,38,0.12); border: 2px solid rgba(220,38,38,0.3)"
      >
        <svg
          class="w-8 h-8 text-red-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"
          ></path>
        </svg>
      </div>
      <h1 class="text-xl font-bold mb-2" style="color: var(--primary)">
        Link inválido o expirado
      </h1>
      <p class="text-sm mb-6" style="color: var(--tertiary)">
        El link de recuperación ya no es válido. Podés solicitar uno nuevo.
      </p>
      <a
        href="/recuperar"
        class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-6 py-3 rounded-2xl text-sm transition-colors active:scale-[0.99]"
      >
        Solicitar nuevo link
      </a>
    </div>

    <div id="estado-formulario" class="w-full max-w-md hidden">
      <div class="mb-6 text-center">
        <LogoBrand />
      </div>
      <div
        class="p-6 rounded-3xl border"
        style="background: var(--elevated-60); border-color: var(--border-strongest)"
      >
        <h1 class="text-lg font-bold mb-1" style="color: var(--primary)">
          Nueva contraseña
        </h1>
        <p class="text-xs mb-5" style="color: var(--tertiary)">
          Elegí una contraseña nueva para tu cuenta.
        </p>

        <div
          id="alerta-error"
          class="hidden text-xs p-4 rounded-2xl mb-4 flex items-start gap-2.5"
          style="background: var(--alert-error-bg); border: 1px solid var(--alert-error-border); color: var(--alert-error-text)"
        >
          <span class="font-bold">⚠️</span>
          <span id="alerta-error-texto">Error.</span>
        </div>

        <form id="form-password" class="space-y-4">
          <div class="relative">
            <label
              for="password"
              class="block text-xs font-semibold uppercase tracking-wider mb-2"
              style="color: var(--tertiary)"
            >
              Nueva Contraseña
            </label>
            <input
              id="password"
              type="password"
              required
              minlength="8"
              placeholder="Mín. 8 caracteres con letras y números"
              class="w-full px-4 py-3 pr-12 rounded-2xl text-sm focus:outline-none focus:border-emerald-500 transition-colors"
              style="background: var(--elevated); color: var(--primary); border: 1px solid var(--border-strong)"
            />
            <button
              type="button"
              id="toggle-password"
              class="absolute right-3 top-[38px] -translate-y-1/2 cursor-pointer"
              style="color: var(--quaternary)"
              aria-label="Mostrar contraseña"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>

          <div class="relative">
            <label
              for="password-confirmar"
              class="block text-xs font-semibold uppercase tracking-wider mb-2"
              style="color: var(--tertiary)"
            >
              Confirmar Contraseña
            </label>
            <input
              id="password-confirmar"
              type="password"
              required
              minlength="8"
              placeholder="Repetí la contraseña"
              class="w-full px-4 py-3 pr-12 rounded-2xl text-sm focus:outline-none focus:border-emerald-500 transition-colors"
              style="background: var(--elevated); color: var(--primary); border: 1px solid var(--border-strong)"
            />
            <button
              type="button"
              id="toggle-password-confirmar"
              class="absolute right-3 top-[38px] -translate-y-1/2 cursor-pointer"
              style="color: var(--quaternary)"
              aria-label="Mostrar contraseña"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>

          <button
            type="submit"
            id="btn-cambiar"
            class="w-full bg-emerald-600 hover:bg-emerald-500 text-white py-3.5 rounded-2xl text-sm font-bold flex items-center justify-center gap-2 transition-colors active:scale-[0.99] cursor-pointer"
          >
            Cambiar contraseña
          </button>
        </form>
      </div>
    </div>

    <div id="estado-exito" class="text-center hidden">
      <div class="mb-6">
        <LogoBrand />
      </div>
      <div
        class="w-16 h-16 mx-auto mb-6 rounded-full flex items-center justify-center"
        style="background: rgba(16,185,129,0.15); border: 2px solid rgba(16,185,129,0.4)"
      >
        <svg
          class="w-8 h-8 text-emerald-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
        </svg>
      </div>
      <h1 class="text-xl font-bold mb-2" style="color: var(--primary)">
        ¡Contraseña actualizada!
      </h1>
      <p class="text-sm mb-1" style="color: var(--secondary)">
        Tu contraseña se cambió correctamente.
      </p>
      <p class="text-xs" style="color: var(--tertiary)">
        <a
          href="/mi-cv"
          class="text-emerald-400 underline hover:text-emerald-300 transition-colors"
        >
          Ir al panel de control
        </a>
      </p>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../../utils/supabase'

  const elCargando = document.getElementById('estado-cargando') as HTMLDivElement
  const elError = document.getElementById('estado-error') as HTMLDivElement
  const elFormulario = document.getElementById('estado-formulario') as HTMLDivElement
  const elExito = document.getElementById('estado-exito') as HTMLDivElement
  const alertaError = document.getElementById('alerta-error') as HTMLDivElement
  const alertaErrorTexto = document.getElementById('alerta-error-texto') as HTMLSpanElement
  const form = document.getElementById('form-password') as HTMLFormElement
  const passwordInput = document.getElementById('password') as HTMLInputElement
  const passwordConfirmar = document.getElementById('password-confirmar') as HTMLInputElement
  const btnCambiar = document.getElementById('btn-cambiar') as HTMLButtonElement

  function mostrarEstado(estado: 'cargando' | 'error' | 'formulario' | 'exito') {
    elCargando.classList.toggle('hidden', estado !== 'cargando')
    elError.classList.toggle('hidden', estado !== 'error')
    elFormulario.classList.toggle('hidden', estado !== 'formulario')
    elExito.classList.toggle('hidden', estado !== 'exito')
  }

  function mostrarError(msj: string) {
    alertaErrorTexto.textContent = msj
    alertaError.classList.remove('hidden')
    window.scrollTo({ top: 0, behavior: 'smooth' })
  }

  // Detectar token de recovery en la URL
  const hashParams = new URLSearchParams(window.location.hash.slice(1))
  const type = hashParams.get('type')
  const accessToken = hashParams.get('access_token')
  const refreshToken = hashParams.get('refresh_token')

  async function procesarRecuperacion() {
    // Verificar si hay un error en la URL
    const errorCode = hashParams.get('error_code') || hashParams.get('error')
    if (errorCode) {
      mostrarEstado('error')
      return
    }

    // Si tenemos tokens, establecer sesión
    if (type === 'recovery' && accessToken && refreshToken) {
      const { error } = await supabase.auth.setSession({
        access_token: accessToken,
        refresh_token: refreshToken,
      })

      if (error) {
        mostrarEstado('error')
        return
      }

      // Token válido, mostrar formulario
      mostrarEstado('formulario')
      window.history.replaceState({}, document.title, window.location.pathname)
      return
    }

    // Fallback: verificar sesión actual
    const {
      data: { session },
    } = await supabase.auth.getSession()
    if (session) {
      // Ya está autenticado, puede cambiar la contraseña
      mostrarEstado('formulario')
      return
    }

    // No hay token válido
    mostrarEstado('error')
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()

    const password = passwordInput.value
    const confirmar = passwordConfirmar.value

    if (password.length < 8) {
      mostrarError('La contraseña debe tener al menos 8 caracteres.')
      passwordInput.focus()
      return
    }

    const tieneLetra = /[a-zA-Z]/.test(password)
    const tieneNumero = /\d/.test(password)
    if (!tieneLetra || !tieneNumero) {
      mostrarError('La contraseña debe incluir letras y números.')
      passwordInput.focus()
      return
    }

    if (password !== confirmar) {
      mostrarError('Las contraseñas no coinciden.')
      passwordConfirmar.focus()
      return
    }

    alertaError.classList.add('hidden')
    btnCambiar.disabled = true
    btnCambiar.textContent = 'Guardando...'

    try {
      const { error } = await supabase.auth.updateUser({ password })

      if (error) {
        mostrarError(error.message || 'Error al actualizar la contraseña.')
      } else {
        mostrarEstado('exito')
        setTimeout(() => {
          window.location.href = '/mi-cv'
        }, 2000)
      }
    } catch {
      mostrarError('Error de conexión al servidor.')
    } finally {
      btnCambiar.disabled = false
      btnCambiar.textContent = 'Cambiar contraseña'
    }
  })

  const SVG_EYE_OFF =
    '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>'
  const SVG_EYE_ON =
    '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>'

  function togglePass(inputId: string, btnId: string) {
    const input = document.getElementById(inputId) as HTMLInputElement
    const btn = document.getElementById(btnId)
    if (!input || !btn) return
    const isPass = input.type === 'password'
    input.type = isPass ? 'text' : 'password'
    btn.innerHTML = isPass ? SVG_EYE_OFF : SVG_EYE_ON
  }

  document
    .getElementById('toggle-password')
    ?.addEventListener('click', () => togglePass('password', 'toggle-password'))
  document
    .getElementById('toggle-password-confirmar')
    ?.addEventListener('click', () => togglePass('password-confirmar', 'toggle-password-confirmar'))

  procesarRecuperacion()
</script>
